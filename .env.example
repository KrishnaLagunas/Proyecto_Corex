# Configuración del servidor
PORT=3000
NODE_ENV=development

# Configuración de la base de datos
DB_HOST=localhost
DB_PORT=3306
DB_NAME=erp_municipal
DB_USER=root
DB_PASS=Klp61727

# Configuración de JWT
JWT_SECRET=secreto_super_seguro_cambiar_en_produccion
JWT_EXPIRES_IN=24h

# Configuración de logs
LOG_LEVEL=info

# Configuración de rutas
UPLOADS_DIR=uploads
PDF_DIR=uploads/pdf

# Integración de Mercado Pago
# Copia el Access Token de TEST del "Seller Test User" en el Panel de Desarrolladores
# Ejemplo: MERCADO_PAGO_ACCESS_TOKEN=TEST-1234567890-ABCDEFGHIJKL
MERCADO_PAGO_ACCESS_TOKEN=

# URL pública base usada para back_urls de Mercado Pago (puede ser http en local)
# En desarrollo normalmente: http://localhost:3001
PUBLIC_BASE_URL=http://localhost:3001